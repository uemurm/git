# This file should work without copying to %USERPROFILE%\.gitconfig
[alias]
	ci = commit
	cf = config
	br = branch
	co = checkout
	st = status
	p  = push
	pl = pull
	f  = fetch
[user]
	name = Mitsu Uemura
	email = mitsuhide.uemura@gmail.com

[push]
	autoSetupRemote = true 	# Assume --set-upstream on default push when no upstream tracking exists for the current branch. (v2.37+)
[init]
	defaultBranch = main
